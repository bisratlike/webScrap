# Server
PORT=3000
WEBSITE_URL=http://localhost:3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/datasnap

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin seed (optional – defaults shown)
ADMIN_EMAIL=admin@datasnap.pro
ADMIN_NAME=Admin
ADMIN_PASSWORD=Admin1234!

# Gemini AI (get from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Stripe (get sandbox keys from https://dashboard.stripe.com/test)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_price_id

# URLs
SUCCESS_URL=http://localhost:3000/success.html
CANCEL_URL=http://localhost:3000/register.html
