{
  "env": { "browser": true, "es2021": true, "webextensions": true },
  "extends": ["eslint:recommended", "plugin:react/recommended"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "rules": {
    "react/prop-types": "off",
    "no-unused-vars": "warn"
  },
  "settings": { "react": { "version": "detect" } }
}
